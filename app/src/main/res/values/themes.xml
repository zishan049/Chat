<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Modern Chat Theme (Light Mode Default) -->
    <style name="Theme.Chat" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:statusBarColor">#F4F6F8</item>
        <item name="android:navigationBarColor">#F4F6F8</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowSplashScreenBackground">#F4F6F8</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash_icon</item>
    </style>
</resources>
